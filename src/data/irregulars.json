[
  {
    "id": "suru-passive",
    "category": "class",
    "title": "する before れる: さ",
    "note": "する has three 未然形 stems. し goes in front of ない, but the passive れる takes さ, giving される.",
    "match": {
      "classes": [
        "suru"
      ]
    },
    "suffix": "passive",
    "stems": [
      "mizenkei"
    ],
    "target": "stem",
    "rule": {
      "drop": 2,
      "add": "さ"
    }
  },
  {
    "id": "suru-causative",
    "category": "class",
    "title": "する before せる: さ",
    "note": "The causative also takes さ, giving させる. (Not する→しさせる.)",
    "match": {
      "classes": [
        "suru"
      ]
    },
    "suffix": "causative",
    "stems": [
      "mizenkei"
    ],
    "target": "stem",
    "rule": {
      "drop": 2,
      "add": "さ"
    }
  },
  {
    "id": "suru-zu",
    "category": "class",
    "title": "する before ず: せ",
    "note": "The literary negative ず takes せ: せず, 勉強せずに.",
    "match": {
      "classes": [
        "suru"
      ]
    },
    "suffix": "zu",
    "stems": [
      "mizenkei"
    ],
    "target": "stem",
    "rule": {
      "drop": 2,
      "add": "せ"
    }
  },
  {
    "id": "suru-potential",
    "category": "suppletion",
    "title": "する → できる",
    "note": "The potential of する is a different verb altogether: できる. It replaces the whole stem-plus-suffix result.",
    "match": {
      "classes": [
        "suru"
      ]
    },
    "suffix": "potential",
    "target": "form",
    "rule": {
      "drop": 2,
      "add": "できる"
    }
  },
  {
    "id": "aru-neg",
    "category": "suppletion",
    "title": "ある → ない",
    "note": "The negative of ある is not あらない but ない. Everything built on ある (てある, ことがある) inherits this.",
    "match": {
      "verbs": [
        "aru"
      ]
    },
    "suffix": "neg",
    "target": "form",
    "rule": {
      "drop": 2,
      "add": "ない"
    }
  },
  {
    "id": "iku-te",
    "category": "sound-change",
    "title": "行く → 行って",
    "note": "Regular く verbs become いて. 行く is the exception: 行って, not 行いて.",
    "match": {
      "verbs": [
        "iku"
      ]
    },
    "stems": [
      "te_stem"
    ],
    "target": "stem",
    "rule": {
      "drop": 1,
      "add": "って"
    }
  },
  {
    "id": "iku-ta",
    "category": "sound-change",
    "title": "行く → 行った",
    "note": "The た-form follows the て-form: 行った.",
    "match": {
      "verbs": [
        "iku"
      ]
    },
    "stems": [
      "ta_stem"
    ],
    "target": "stem",
    "rule": {
      "drop": 1,
      "add": "った"
    }
  },
  {
    "id": "tou-te",
    "category": "sound-change",
    "title": "問う → 問うて",
    "note": "A few literary う verbs keep the う instead of doubling the consonant: 問うて.",
    "match": {
      "verbs": [
        "tou"
      ]
    },
    "stems": [
      "te_stem"
    ],
    "target": "stem",
    "rule": {
      "drop": 0,
      "add": "て"
    }
  },
  {
    "id": "tou-ta",
    "category": "sound-change",
    "title": "問う → 問うた",
    "note": "The た-form follows the て-form: 問うた.",
    "match": {
      "verbs": [
        "tou"
      ]
    },
    "stems": [
      "ta_stem"
    ],
    "target": "stem",
    "rule": {
      "drop": 0,
      "add": "た"
    }
  },
  {
    "id": "honorific-renyokei",
    "category": "honorific",
    "title": "Honorific godan verbs: ります → います",
    "note": "いらっしゃる, なさる, くださる and おっしゃる are godan verbs whose 連用形 ends in い instead of り: いらっしゃいます, not いらっしゃります.",
    "match": {
      "verbs": [
        "irassharu",
        "nasaru",
        "kudasaru",
        "ossharu"
      ]
    },
    "stems": [
      "renyokei"
    ],
    "target": "stem",
    "rule": {
      "drop": 1,
      "add": "い"
    }
  },
  {
    "id": "gozaru-renyokei",
    "category": "honorific",
    "title": "ござる → ございます",
    "note": "The humble-polite ござる behaves like the honorific godan verbs: ございます.",
    "match": {
      "verbs": [
        "gozaru"
      ]
    },
    "stems": [
      "renyokei"
    ],
    "target": "stem",
    "rule": {
      "drop": 1,
      "add": "い"
    }
  },
  {
    "id": "honorific-meireikei",
    "category": "honorific",
    "title": "Honorific godan verbs: imperative in い",
    "note": "The commands are いらっしゃい, なさい, ください, おっしゃい. They are soft, polite requests rather than blunt orders.",
    "match": {
      "verbs": [
        "irassharu",
        "nasaru",
        "kudasaru",
        "ossharu"
      ]
    },
    "stems": [
      "meireikei"
    ],
    "target": "stem",
    "rule": {
      "drop": 1,
      "add": "い"
    }
  },
  {
    "id": "ii-lemma",
    "category": "adjective",
    "title": "いい → よい",
    "note": "いい only exists in the dictionary form. Every other form is built on よい: よくない, よかった, よくて, よければ. Compounds (かっこいい, ほうがいい) inherit this.",
    "match": {
      "verbs": [
        "ii"
      ]
    },
    "stems": [
      "renyokei",
      "kateikei",
      "te_stem",
      "ta_stem",
      "gokan"
    ],
    "target": "lemma",
    "rule": {
      "drop": 2,
      "add": "よい"
    }
  },
  {
