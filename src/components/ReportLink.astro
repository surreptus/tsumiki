---
// Replaces Starlight's "Edit page" link: most readers cannot edit the source, but anyone can report a mistake.
import { Icon } from '@astrojs/starlight/components';

const page = new URL(Astro.url.pathname, Astro.site).href;
const href = `https://github.com/surreptus/tsumiki/issues/new?template=wrong-japanese.yml&page=${encodeURIComponent(page)}`;
---

<a href={href} class="sl-flex print:hidden" rel="noopener">
  <Icon name="pencil" size="1.2em" />
  Report a mistake on this page
</a>

<style>
  @layer starlight.core {
    a { gap: 0.5rem; align-items: center; text-decoration: none; color: var(--sl-color-gray-3); }
    a:hover { color: var(--sl-color-white); }
  }
</style>
