---
// A suffix fits one stem, like a puzzle piece.
import TypeLegend from '../TypeLegend.astro';
---
<figure class="illus">
  <svg viewBox="0 0 480 142" role="img" aria-labelledby="suffixes-art-t">
    <title id="suffixes-art-t">The suffix たい has a round notch that fits the round tab of the stem 書き, making 書きたい. The stem 書か has a square tab, so it does not fit, and 書かたい is wrong.</title>
    <path class="il-stem il-solid" d="M10 10H90V24a10 10 0 0 1 0 20V58H10Z" />
    <text class="il-t" x="48" y="34">書き</text>
    <path class="il-mach" d="M90 10H170V58H90V44a10 10 0 0 0 0-20Z" />
    <text class="il-t" x="138" y="34">たい</text>
    <path class="il-a" d="M180 34H191" /><path class="il-ah" d="M200 34l-9-5.5v11z" />
    <rect class="il-blk type-i-adj" x="205" y="10" width="120" height="48" rx="8" />
    <text class="il-t" x="265" y="34">書きたい</text>
    <circle class="il-ok" cx="355" cy="34" r="12" />
    <text class="il-s il-l" x="382" y="34">fits</text>
    <path class="il-stem il-solid" d="M10 84H90V98h10v20H90V132H10Z" />
    <text class="il-t" x="48" y="108">書か</text>
    <path class="il-mach" d="M120 84H200V132H120V118a10 10 0 0 0 0-20Z" />
    <text class="il-t" x="168" y="108">たい</text>
    <path class="il-bad" d="M222 100l16 16M238 100l-16 16" />
    <text class="il-s il-l il-bad-t" x="253" y="108">wrong stem</text>
  </svg>
  <figcaption>A suffix takes exactly one stem. Any other stem does not fit.</figcaption>
  <TypeLegend types={['verb', 'i-adj']} />
</figure>
