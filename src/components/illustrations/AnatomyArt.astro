---
// The anatomy of one long form: the nested call, with a plain-English label on each function.
import TypeLegend from '../TypeLegend.astro';
---
<figure class="illus il-anatomy" tabindex="0" aria-label="Annotated function call, scrolls sideways on narrow screens">
  <svg viewBox="-16 0 682 280" role="img" aria-labelledby="anatomy-art-t">
    <title id="anatomy-art-t">The call past(neg(tai(passive(causative(食べる))))) with each part labelled. 食べる is the verb "eat". causative makes someone do it, passive means it happens to you, tai means want to, neg means not, and past means in the past. Green marks an い-adjective result and purple a verb.</title>
    <rect class="il-hl type-i-adj" x="27" y="127" width="63.6" height="40" rx="7" />
    <rect class="il-hl type-i-adj" x="99" y="127" width="49.2" height="40" rx="7" />
    <rect class="il-hl type-i-adj" x="156.6" y="127" width="49.2" height="40" rx="7" />
    <rect class="il-hl type-verb" x="214.2" y="127" width="106.8" height="40" rx="7" />
    <rect class="il-hl type-verb" x="329.4" y="127" width="135.6" height="40" rx="7" />
    <rect class="il-hl type-verb" x="473.4" y="127" width="78" height="40" rx="7" />
    <path class="il-lead" d="M58.8 70 C58.8 104 58.8 104 58.8 124" />
    <path class="il-lead" d="M123.6 170 C123.6 192 123.6 202 123.6 224" />
    <path class="il-lead" d="M181.2 70 C181.2 104 181.2 104 181.2 124" />
    <path class="il-lead" d="M267.6 170 C267.6 192 267.6 202 267.6 224" />
    <path class="il-lead" d="M397.2 70 C397.2 104 397.2 104 397.2 124" />
    <path class="il-lead" d="M512.4 170 C512.4 192 512.4 202 512.4 224" />
    <text class="il-code il-fn" x="30" y="147" textLength="57.6" lengthAdjust="spacingAndGlyphs">past</text>
    <text class="il-code" x="87.6" y="147" textLength="14.4" lengthAdjust="spacingAndGlyphs">(</text>
    <text class="il-code il-fn" x="102" y="147" textLength="43.2" lengthAdjust="spacingAndGlyphs">neg</text>
    <text class="il-code" x="145.2" y="147" textLength="14.4" lengthAdjust="spacingAndGlyphs">(</text>
    <text class="il-code il-fn" x="159.6" y="147" textLength="43.2" lengthAdjust="spacingAndGlyphs">tai</text>
    <text class="il-code" x="202.8" y="147" textLength="14.4" lengthAdjust="spacingAndGlyphs">(</text>
    <text class="il-code il-fn" x="217.2" y="147" textLength="100.8" lengthAdjust="spacingAndGlyphs">passive</text>
    <text class="il-code" x="318" y="147" textLength="14.4" lengthAdjust="spacingAndGlyphs">(</text>
    <text class="il-code il-fn" x="332.4" y="147" textLength="129.6" lengthAdjust="spacingAndGlyphs">causative</text>
    <text class="il-code" x="462" y="147" textLength="14.4" lengthAdjust="spacingAndGlyphs">(</text>
    <text class="il-code il-fn" x="476.4" y="147" textLength="72" lengthAdjust="spacingAndGlyphs">食べる</text>
    <text class="il-code" x="548.4" y="147" textLength="72" lengthAdjust="spacingAndGlyphs">)))))</text>
    <rect class="il-card type-i-adj" x="-4.2" y="40" width="126" height="32" rx="16" />
    <text class="il-t il-cardt" x="58.8" y="56">in the past</text>
    <rect class="il-card type-i-adj" x="96.1" y="224" width="55" height="32" rx="16" />
    <text class="il-t il-cardt" x="123.6" y="240">not</text>
    <rect class="il-card type-i-adj" x="136.2" y="40" width="90" height="32" rx="16" />
    <text class="il-t il-cardt" x="181.2" y="56">want to</text>
    <rect class="il-card type-verb" x="178.1" y="224" width="179" height="32" rx="16" />
    <text class="il-t il-cardt" x="267.6" y="240">it happens to you</text>
    <rect class="il-card type-verb" x="303.2" y="40" width="188" height="32" rx="16" />
    <text class="il-t il-cardt" x="397.2" y="56">make someone do it</text>
    <rect class="il-card type-verb" x="440.4" y="224" width="144" height="32" rx="16" />
    <text class="il-t il-cardt" x="512.4" y="240">the verb: eat</text>
  </svg>
  <figcaption>One word, five function calls, read from the inside out. Colour is the type of what each call returns.</figcaption>
  <TypeLegend types={['verb', 'i-adj']} />
</figure>
