---
// Header block for a suffix page: reading, attach point, meaning, construction, notes, examples.
// Everything searchable about a suffix is rendered here so Pagefind indexes it.
import { getEntry, getCollection } from 'astro:content';
import { suffixHref, stemHref, slug } from '../lib/paths';
import { suffixName } from '../lib/names';
import SuffixSections from './SuffixSections.astro';
import PracticePrompt from './PracticePrompt.astro';
import { construction } from '../lib/construction';
import { suffixPrompt } from '../lib/tutor-prompt';

interface Props {
  id: string;
}
const entry = await getEntry('suffixes', Astro.props.id);
if (!entry) throw new Error(`<SuffixCard>: unknown suffix "${Astro.props.id}"`);
const s = entry.data;

const stems = new Map((await getCollection('stems')).map((e) => [e.id, e.data]));
const attach = stems.get(s.attaches_to);
const allSuffixes = (await getCollection('suffixes')).map((e) => e.data);
const nameOf = (id: string) => {
  const r = allSuffixes.find((x) => x.id === id)!;
  return suffixName(r);
};
// suffixes whose page is a section of this one (documented_on: "mizenkei/causative#...")
const here = `${slug(s.attaches_to)}/${slug(s.id)}`;
const merged = allSuffixes.filter((m) => m.documented_on?.startsWith(`${here}#`));
const compared = new Set(s.compare.map((c) => c.id));
const prompt = suffixPrompt({
  suffix: { ...s, title: suffixName(s) },
  attach: attach ? `${attach.name} (${attach.label})` : s.attaches_to === 'dictionary' ? 'the dictionary form' : 'a plain clause',
  rows: construction(s.id),
  compare: s.compare.map((c) => ({ label: c.id ? nameOf(c.id) : c.label ?? '', difference: c.difference })),
  merged: merged.map((m) => ({ title: suffixName(m), meaning: m.meaning, rows: construction(m.id), usage: m.usage, examples: m.examples })),
  path: `/reference/suffixes/${slug(s.attaches_to)}/${slug(s.id)}/`,
});
const related = allSuffixes.filter((r) => s.related.includes(r.id) && !compared.has(r.id));
---
<div class="suffix-card">
  <dl>
    <div>
      <dt>Romaji</dt>
      <dd>{s.form && s.form !== (s.display ?? s.written ?? s.form) && <><span lang="ja">{s.form}</span> · </>}{s.romaji}</dd>
    </div>
    <div>
      <dt>Attaches to</dt>
      <dd>
        {attach
          ? <><a href={stemHref(attach.id)}><span lang="ja">{attach.name}</span></a> ({attach.label})</>
          : s.attaches_to === 'dictionary' ? 'the dictionary form' : 'a plain clause'}
      </dd>
    </div>
    <div><dt>Meaning</dt><dd>{s.meaning}</dd></div>
    {s.register && <div><dt>Register</dt><dd>{s.register}</dd></div>}
    {related.length > 0 && (
      <div>
        <dt>See also</dt>
        <dd>{related.map((r, i) => <>{i > 0 && ', '}<a href={suffixHref(r)} lang="ja">{suffixName(r)}</a></>)}</dd>
      </div>
    )}
  </dl>

  <SuffixSections s={s} />

  {merged.map((m) => (
    <>
      <h2 id={slug(m.id)}>{m.meaning.split(':')[0]} (<span lang="ja">{suffixName(m)}</span>)</h2>
      <p>{m.meaning.includes(':') ? m.meaning.split(':').slice(1).join(':').trim().replace(/^./, (c) => c.toUpperCase()) : m.meaning}</p>
      <SuffixSections s={m} level={3} prefix={`${slug(m.id)}-`} />
    </>
  ))}

  <PracticePrompt prompt={prompt} />
</div>
